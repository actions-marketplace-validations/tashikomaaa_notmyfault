{
  "name": "notmyfault",
  "version": "1.7.0",
  "description": "Tells you whether a failing test is your fault or a known flaky test, in GitHub Actions and GitLab CI/CD. No server, no runtime dependencies.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Aldwin Moutarlier",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --legal-comments=none --outfile=dist/index.js && esbuild src/cli.ts --bundle --platform=node --target=node24 --format=esm --legal-comments=none --outfile=dist/notmyfault.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "site": "node scripts/site.ts _site",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "github-actions",
    "gitlab-ci",
    "flaky-tests",
    "junit",
    "ci",
    "testing"
  ],
  "devDependencies": {
    "@types/node": "^24.13.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
